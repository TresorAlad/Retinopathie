# Local : mot de passe PostgreSQL de ta machine.
# Docker : laisser tel quel ; docker-compose.yml écrase DATABASE_URL pour le service api.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/diabetic_retinopathy

# Génère des clés avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Génère avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_WITH_FERNET_KEY

STORAGE_DIR=storage
MAX_IMAGE_SIZE_MB=10

# Service IA (dossier ia/). Vide = pas d'appel IA (ai_status pending).
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_SEC=30
