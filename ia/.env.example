# Rodium AI (recommandé pour les tests) - https://www.rodiumai.io
RODIUMAI_API_KEY=rd_sk_votre_cle
RODIUMAI_BASE_URL=https://api.rodiumai.io/v1
RODIUMAI_VISION_MODEL=openai/gpt-4o
RODIUMAI_AGENT_MODEL=openai/gpt-4o-mini

# rodium | local | auto (auto = rodium si clé présente, sinon PyTorch local)
IA_INFERENCE_MODE=auto

# Agent: rodium (défaut) ou rule-based
IA_AGENT_MODE=rodium

# Chemins PyTorch si IA_INFERENCE_MODE=local
EYE_CHECKER_MODEL_PATH=models/eye_checker.pt
STAGE_CLASSIFIER_MODEL_PATH=models/stage_classifier.pt
